<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>false</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <!--
      Xbox Series S Dev Mode caps the whole process at ~5 GiB. Background GC
      keeps extra segments alive and RetainVM hides freed memory from the OS
      quota, so prefer a compact, non-concurrent workstation GC.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <!-- Optional hard cap for the managed heap (bytes, 0 = disabled). -->
    <RyuboxGCHeapHardLimit Condition="'$(RyuboxGCHeapHardLimit)' == ''">0</RyuboxGCHeapHardLimit>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0-9: higher values compact more aggressively to reduce fragmentation. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="$(RyuboxGCHeapHardLimit)" Condition="'$(RyuboxGCHeapHardLimit)' != '0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop Avalonia configuration bridge is not part of the NativeAOT UWP host. -->
    <Compile Remove="RyuboxSettingsBridge.cs" />
    <TrimmerRootDescriptor Include="NativeAotRoots.rd.xml" />
    <ProjectReference Include="..\src\Ryujinx.HLE\Ryujinx.HLE.csproj" />
    <ProjectReference Include="..\src\Ryujinx.Graphics.Vulkan\Ryujinx.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\src\Ryujinx.Graphics.D3D11\Ryujinx.Graphics.D3D11.csproj" />
    <ProjectReference Include="..\src\Ryujinx.Graphics.D3D12\Ryujinx.Graphics.D3D12.csproj" />
    <ProjectReference Include="..\src\Ryujinx.Common\Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
