<Page
    x:Class="Ryujinx.Uwp.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ryujinx.Uwp.App"
    Background="Black">

    <Grid>
        <SwapChainPanel x:Name="GameSurfacePanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        UseLayoutRounding="True"
                        IsHitTestVisible="True"
                        SizeChanged="GameSurfacePanel_SizeChanged"
                        CompositionScaleChanged="GameSurfacePanel_CompositionScaleChanged"/>
        <Grid x:Name="BootOverlay"
              Background="Black"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Image x:Name="BootLogo"
                   Source="ms-appx:///Assets/RyuboxLogoMaster.png"
                   Width="220"
                   Height="80"
                   Margin="42,34,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Stretch="Uniform"/>
            <!-- Assigned only when a verified Logo Partition asset is available. -->
            <Image x:Name="BootStartupMovie"
                   Width="260"
                   Height="146"
                   Margin="0,0,42,34"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing x:Name="BootSpinner" IsActive="True" Width="42" Height="42"/>
                <TextBlock x:Name="BootStatus"
                           Margin="0,20,0,0"
                           Foreground="White"
                           FontSize="20"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="760"/>
                <TextBlock x:Name="BootError"
                           Margin="0,16,0,0"
                           Foreground="#FFFF8080"
                           FontSize="17"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
