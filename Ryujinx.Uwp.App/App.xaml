<Application
    x:Class="Ryujinx.Uwp.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ryujinx.Uwp.App">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#09070D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============================================================
                 PALETA — "dev-kit" escuro com leitura tipo terminal/BIOS.
                 Base quase-preta azulada, acento verde-Ryujinx para estados
                 "ok", âmbar para "pendente/atenção", vermelho só para erro.
                 ============================================================ -->
            <Color x:Key="ColorBackground">#09070D</Color>
            <Color x:Key="ColorSurface">#0D0D12</Color>
            <Color x:Key="ColorSurfaceElevated">#17121D</Color>
            <Color x:Key="ColorSurfaceInset">#070609</Color>
            <Color x:Key="ColorBorder">#554A60</Color>
            <Color x:Key="ColorBorderStrong">#7C7580</Color>

            <Color x:Key="ColorAccent">#FF0080</Color>
            <Color x:Key="ColorAccentStrong">#00E5FF</Color>
            <Color x:Key="ColorAccentDim">#FF008033</Color>
            <Color x:Key="ColorWarning">#FF9F1C</Color>
            <Color x:Key="ColorWarningDim">#FF9F1C26</Color>
            <Color x:Key="ColorDanger">#FF6B6B</Color>
            <Color x:Key="ColorDangerDim">#FF6B6B26</Color>

            <Color x:Key="ColorTextPrimary">#FAF8FF</Color>
            <Color x:Key="ColorTextSecondary">#A69BAF</Color>
            <Color x:Key="ColorTextTertiary">#6D6374</Color>
            <Color x:Key="ColorOnAccent">#FFFFFF</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource ColorSurfaceElevated}" />
            <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource ColorSurfaceInset}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorBorderStrong}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource ColorAccentStrong}" />
            <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource ColorAccentDim}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
            <SolidColorBrush x:Key="WarningDimBrush" Color="{StaticResource ColorWarningDim}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
            <SolidColorBrush x:Key="DangerDimBrush" Color="{StaticResource ColorDangerDim}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource ColorOnAccent}" />

            <!-- Foco do gamepad precisa ser visível a 3 metros de distância -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource ColorAccentStrong}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource ColorBackground}" />

            <!-- ============================================================
                 TIPOGRAFIA — UI em Segoe, dados/telemetria em monoespaçada.
                 O painel de status lê como um readout de firmware, não como
                 um formulário: é a assinatura visual do app.
                 ============================================================ -->
            <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MonoValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HintBarStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FooterTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            </Style>

            <!-- ============================================================
                 BOTÕES — dois papéis (primário sólido / secundário contornado),
                 com estados claros para mouse, controle e foco a distância.
                 ============================================================ -->
            <Style x:Key="BasePillButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,11" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="4">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="PressTransform" Y="0" />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="RootGrid"
                                                                 Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                                 To="{StaticResource ColorSurfaceElevated}" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressTransform" Storyboard.TargetProperty="Y" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused" />
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTransitions="{TemplateBinding ContentTransitions}"
                                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                   Padding="{TemplateBinding Padding}"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                <Rectangle x:Name="FocusRing" IsHitTestVisible="False" Opacity="0"
                                           Stroke="{StaticResource AccentStrongBrush}" StrokeThickness="2.5"
                                           RadiusX="6" RadiusY="6" Margin="-4" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BasePillButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BasePillButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="RowLaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <!-- ============================================================
                 LISTA DE JOGOS — item com barra de seleção lateral e foco
                 nítido para navegação por D-pad.
                 ============================================================ -->
            <Style x:Key="GameListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="RootGrid" Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                  CornerRadius="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="SelectionBar" Fill="{StaticResource AccentBrush}" Opacity="0" />
                                <ContentPresenter x:Name="ContentPresenter" Grid.Column="1"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)" To="{StaticResource ColorSurfaceElevated}" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)" To="{StaticResource ColorSurfaceElevated}" Duration="0" />
                                                <ColorAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Grid.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource ColorAccent}" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="SelectionBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Grid.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource ColorAccent}" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="SelectionBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused" />
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Grid.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource ColorAccentStrong}" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LibraryListViewStyle" TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource GameListViewItemStyle}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="GameGridViewItemStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,14,18" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="LibraryGridViewStyle" TargetType="GridView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource GameGridViewItemStyle}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            </Style>

            <Style x:Key="AccentProgressRingStyle" TargetType="ProgressRing">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
            </Style>

            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="CharacterSpacing" Value="100" />
            </Style>

            <Style x:Key="KeysListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
